{
  "name": "zest-kcal-tracker-template",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "verify": "npm run typecheck && npm run lint && npm test",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.cjs",
    "test:ios": "bash scripts/test-ios.sh"
  },
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.12",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "decode-uri-component": "file:packages/decode-uri-component-compat"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": false,
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "decode-uri-component": "$decode-uri-component"
  },
  "description": "An independent light-themed food diary cookbook with native Liquid Glass, animated stickers, and a reactive vector lemon.",
  "license": "MIT",
  "author": {
    "name": "Appllama",
    "url": "https://appllama.io"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "expo",
    "react-native",
    "liquid-glass",
    "food-tracker",
    "skia",
    "reanimated",
    "cookbook"
  ],
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true,
    "unrs-resolver@1.12.2": true
  }
}
