{
  "expo": {
    "name": "Zest",
    "slug": "zest-kcal-tracker-template",
    "scheme": "zest-kcal-tracker",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a7f8ed59-5b36-4c85-980c-a59e4872132d"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.appllama.zestkcaltracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Zest gently follows the movement of your phone."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma foto para anexar ao seu diário.",
          "cameraPermission": "Use a câmera para capturar conteúdo para seu diário.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a7f8ed59-5b36-4c85-980c-a59e4872132d"
      }
    }
  }
}
