{
  "name": "zest-kcal-tracker-template",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "verify": "npm run typecheck && npm run lint && npm test",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.cjs",
    "test:ios": "bash scripts/test-ios.sh"
  },
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.23",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": false,
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  },
  "description": "An independent light-themed food diary cookbook with native Liquid Glass, animated stickers, and a reactive vector lemon.",
  "license": "MIT",
  "author": {
    "name": "Appllama",
    "url": "https://appllama.io"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "expo",
    "react-native",
    "liquid-glass",
    "food-tracker",
    "skia",
    "reanimated",
    "cookbook"
  ],
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@shopify/react-native-skia@2.14.0": true
  }
}
